{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl -fsSL https://bun.com/install | bash -s \"bun-v1.4.4\" && export PATH=\"$HOME/.bun/bin:$PATH\" && bun ci && bun fmt --stdin-filepath vercel.json < vercel.json",
  "buildCommand": "export PATH=\"$HOME/.bun/bin:$PATH\" && bun run check",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "bluetooth=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
