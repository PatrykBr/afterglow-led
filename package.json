{
  "name": "afterglow-led",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~6.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.63.0",
    "esbuild": "npm:esbuild-wasm@^0.27.0"
  }
}
