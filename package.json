{
  "name": "afterglow-led",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --hot scripts/dev.ts",
    "build": "bun run typecheck && bun scripts/build.ts",
    "preview": "bun scripts/preview.ts",
    "typecheck": "bun check --no-script",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "format": "bun fmt src tests scripts index.html package.json tsconfig.json bunfig.toml",
    "format:check": "bun fmt --check src tests scripts index.html package.json tsconfig.json bunfig.toml",
    "check": "bun run format:check && bun run typecheck && bun test --coverage && bun scripts/build.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "@sinonjs/fake-timers": "^15.0.0",
    "@types/sinonjs__fake-timers": "^15.0.0"
  }
}
